# RAG System Environment Configuration
# 复制此文件为 .env 并填入真实值
# ⚠️ 切勿将 .env 提交到版本控制
#
# 加载位置与时机：`.env` 位于进程启动目录（当前工作目录），在进程启动时
# 读取，且早于任何 Settings 构造（CLI/TUI/RAG 一致生效）。
# 覆盖优先级：真实环境变量 > .env > 内置默认值
# 刷新语义：TUI/onboarding 保存配置后经 reset_settings() 重新读取本文件，
# 真实反映文件修改（新值/新增键/删除的键），但绝不覆盖显式进程环境变量。
# 若 API_KEY 与 BASE_URL 已由进程环境提供，TUI 不会进入引导；设置界面也不会
# 覆盖这些进程值，写入 .env 的同名值须在重启且无进程覆盖时生效。
# 路径写法：支持 ~ 展开（Windows 下展开为 %USERPROFILE%），相对路径按进程
# 启动目录解释并绝对化。数据默认不写入 src/ 或包目录。
# 所有数值/范围在进程启动时校验：非法数值或矛盾范围会带配置名直接失败
# （fail-fast），发生在任何索引构建、模型加载、网络访问或目录写入之前。

# P1.1 Minimal 诊断观测默认关闭；显式同意后仅写入 ${MNEME_DATA_DIR}/traces/
# 的匿名化哈希和漏斗元数据，默认保留 30 天。Exact replay 暂不提供。
# 可通过 TUI /consent 与 /delete-trace <id> 管理同意和删除。

# OpenAI 兼容 API
# API_KEY 与 BASE_URL 均为必填 gateway 配置（无内置默认值）：只设置其一
# 会在首次 LLM 调用时以 "API_KEY or BASE_URL not configured" fail-fast，
# 发生在任何索引构建/检索/请求之前。
API_KEY=sk-your-api-key-here
BASE_URL=https://api.openai.com/v1

# LLM 模型（可选，默认 deepseek-chat）
# LLM_MODEL=deepseek-chat

# 温度参数（可选，默认 0.1；允许范围 0.0-2.0）
# LLM_TEMPERATURE=0.1

# 用户 Top-K 区间（可选，默认 3-20；TUI/流式路径使用；必须 1 <= MIN <= MAX）
# 注意：这是“用户可见 Top-K”，与内部检索宽度（固定 70/12/70）以及 Graph
# 内部动态 Top-K（固定 3/50，GRAPH_DYNAMIC_MIN_K/MAX_K）是相互独立的概念，
# 不要混用；后两者不提供环境变量覆盖。
# LLM_TOP_K_MIN=3
# LLM_TOP_K_MAX=20

# Graph RAG Alpha（可选，默认 0.7；允许范围 0.0-1.0）
# ALPHA=0.7

# Embedding 模型（可选）
# 优先级：EMBEDDING_MODEL_PATH（本地路径）> EMBEDDING_MODEL_NAME（模型 ID）
# EMBEDDING_MODEL_PATH 与其他受管路径一致：在进程启动（Settings 构造）时
# 完成 ~ 展开与相对路径绝对化，启动后 CWD 改变不会使 loader 参数漂移。
# 默认优先从本地缓存加载；不可用时通过 ModelScope 下载 all-MiniLM-L6-v2，
# 自动下载缓存到 ${MNEME_DATA_DIR}/models。
# 国内网络可以直接使用 ModelScope，或先下载到本地后设置此路径：
#   pip install modelscope
#   python -c "from modelscope import snapshot_download; snapshot_download('sentence-transformers/all-MiniLM-L6-v2', cache_dir='models')"
# EMBEDDING_MODEL_PATH=./models/sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 数据目录（可选，默认 ~/.mneme；支持 ~ 展开，Windows 下为 %USERPROFILE%\.mneme）
# Chroma DB、BM25 快照、manifest、模型缓存等数据文件存储在此目录下
# MNEME_DATA_DIR=~/.mneme

# 文档根目录（可选，默认 <启动目录>/documents；设置后仅允许索引该目录下的文件）
# MNEME_DOCUMENT_ROOT=./documents

# 远程端点安全：远程 Base URL 默认必须使用 HTTPS。
# 仅本机开发端点允许 http://localhost；不要把文档密钥放入索引。
# MNEME_ALLOW_INSECURE_HTTP=1

# 文档与远程上下文资源上限（按需调整，必须为正整数）
# MNEME_MAX_DOCUMENT_BYTES=52428800
# MNEME_MAX_PDF_PAGES=2000
# MNEME_MAX_REMOTE_CONTEXT_CHARS=60000

# 离线模式（可选，默认关闭）
# 精确承诺：MNEME_OFFLINE=1 仅禁止隐式远程 ModelScope 下载；本地模型照常
# 加载、LLM API 调用不受影响。本地模型缺失时给出明确的纯本地错误。
# MNEME_OFFLINE=1

# 检索拒答阈值（可选，默认 0.03；必须 >= 0）
# RAG_REFUSAL_THRESHOLD=0.03

# LLM 网关并发上限（可选，默认 4；1–32，非法值导入期拒绝启动）
# RAG_LLM_MAX_CONCURRENCY=4

# 查询拆解开关（可选，默认 on；可选值 on | off）
# off = 单查询直通（跳过拆解 LLM 调用，收益计量/回退逃生阀）
# RAG_QUERY_DECOMPOSE=on

# Reranker（可选，默认 none；可选值 none | cross-encoder）
# RAG_RERANKER=none
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# TUI 文件监控目录（可选，TUI 专属配置）
# RAG_WATCH_DIR=./documents
